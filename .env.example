NEATLOGS_API_KEY=
CRUSTDATA_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Optional 3rd LLM provider (neatHack LiteLLM proxy, https://neatlogs.com/hackathon/models).
# Used only after both Gemini models fail; leave the key empty to skip.
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
# options: nova-micro, nova-lite, nova-pro, nova-2-lite, claude-haiku, claude-sonnet-4.6, claude-opus-4.6
LITELLM_MODEL=claude-haiku
